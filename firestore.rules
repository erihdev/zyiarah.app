rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // Single get() — avoids 4 separate comparisons in isAdmin()
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'client');
    }

    // Any admin role
    function isAdmin() {
      return isLoggedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        getUserRole() in ['admin', 'super_admin', 'orders_manager',
                          'accountant_admin', 'marketing_admin']
      );
    }

    // Orders + drivers management
    function isOrdersManager() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'orders_manager'];
    }

    // Financial read access
    function isAccountantAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'accountant_admin'];
    }

    // Marketing content management
    function isMarketingAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'marketing_admin'];
    }

    // Destructive operations: delete users, change system config
    function isSuperAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin'];
    }

    // ─── User Profiles ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // SECURITY: user can only create their own profile, cannot self-assign admin roles
      allow create: if isOwner(userId) &&
        !(request.resource.data.get('role', 'client') in
          ['admin', 'super_admin', 'orders_manager',
           'accountant_admin', 'marketing_admin', 'driver']);

      // User can update own non-sensitive fields; sensitive fields require admin
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'wallet', 'rating_avg', 'rating_count',
                     'total_orders', 'is_blocked']));

      allow delete: if isSuperAdmin();
    }

    // ─── Accountants ──────────────────────────────────────────────────────
    match /accountants/{accountantId} {
      allow read: if isOwner(accountantId) || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isOwner(accountantId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'is_active', 'email']));
    }

    // ─── Account Deletion Requests ────────────────────────────────────────
    match /account_deletions/{deletionId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    // ─── Support Tickets ──────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow create: if isLoggedIn();
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if isLoggedIn() && (
          request.auth.uid ==
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
          || isAdmin()
        );
      }
    }

    // Legacy tickets collection
    match /tickets/{ticketId} {
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isLoggedIn();
      allow delete: if isSuperAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.driver_id ||
        isAdmin()
      );

      // SECURITY: client_id must match caller; payment fields must be safe defaults
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid &&
        request.resource.data.get('is_paid', false) == false &&
        request.resource.data.get('payment_status', 'pending') in ['pending', 'unpaid'] &&
        request.resource.data.get('status', 'pending') == 'pending';

      // Orders manager: full update
      allow update: if isOrdersManager();

      // Driver: update status/location only — cannot touch financial or identity fields
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.driver_id &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['is_paid', 'payment_status', 'amount', 'final_amount',
                   'client_id', 'client_email', 'client_phone', 'driver_id']);

      // Client: cancel own pending order only
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.client_id &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelled_at', 'cancelled_by', 'needs_refund']) &&
        request.resource.data.status == 'cancelled';

      allow delete: if isSuperAdmin();
    }

    // ─── Drivers ──────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == driverId || isAdmin());
      allow write: if isOrdersManager();
      // Driver can update own availability/location — not financial or identity fields
      allow update: if isLoggedIn() &&
        request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['name', 'phone', 'monthly_salary', 'wallet',
                   'rating_avg', 'rating_count', 'rides', 'email',
                   'id_number', 'id_expiry', 'nationality']);
    }

    // ─── FCM Tokens ───────────────────────────────────────────────────────
    match /fcm_tokens/{tokenId} {
      allow read, write: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
    }
    match /fcm_token/{tokenId} {
      allow read, write: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
    }

    // ─── Contracts ────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      // SECURITY: userId must match caller on create
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // ─── Maintenance Requests ─────────────────────────────────────────────
    match /maintenance_requests/{requestId} {
      // SECURITY: ownership validation on create
      allow create: if isLoggedIn() && (
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid ||
        request.resource.data.get('client_id', request.auth.uid) == request.auth.uid
      );
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.get('userId', resource.data.get('client_id', '')) ||
        isAdmin()
      );
      allow update: if isLoggedIn() && (
        request.auth.uid == resource.data.get('userId', resource.data.get('client_id', '')) ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ─── Marketing & Content ──────────────────────────────────────────────
    match /subscription_packages/{packageId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_banners/{bannerId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_codes/{codeId} {
      allow read: if isLoggedIn();
      // Users can only increment `uses` by exactly 1 — prevents abuse
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) &&
        request.resource.data.uses == resource.data.uses + 1;
      allow create, delete: if isMarketingAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }

    // ─── System Settings ──────────────────────────────────────────────────
    // SECURITY: system_configs restricted to admins only (was readable by all)
    match /system_configs/{configId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // SECURITY: order_counter — read-only for users; write locked to increment-only
    match /metadata/{docId} {
      allow get: if isLoggedIn() && docId == 'order_counter';
      allow create: if isLoggedIn() && docId == 'order_counter';
      allow update: if isLoggedIn() && docId == 'order_counter' && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counter']) &&
         request.resource.data.counter == resource.data.counter + 1)
      );
    }

    match /admins/{adminId} {
      allow read: if isLoggedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSuperAdmin();
    }
    match /services/{serviceId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Store ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /store_orders/{orderId} {
      // SECURITY: client_id must match caller on create
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid;
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.client_id || isOrdersManager());
      allow update, delete: if isOrdersManager();
    }

    // ─── Geographic Zones ─────────────────────────────────────────────────
    match /regions/{regionId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /hourly_zones/{zoneId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Logs & Triggers ──────────────────────────────────────────────────

    // SECURITY: audit log entries must carry the caller's own uid
    match /audit_logs/{logId} {
      allow create: if isLoggedIn() &&
        request.resource.data.get('admin_uid', request.auth.uid) == request.auth.uid;
      allow read: if isAccountantAdmin();
      allow delete: if isSuperAdmin();
    }

    // SECURITY: removed `type == 'email'` bypass that allowed arbitrary email spam
    match /notification_triggers/{triggerId} {
      allow create: if isLoggedIn() && (
        !('toUid' in request.resource.data) ||
        request.resource.data.toUid == request.auth.uid ||
        (request.resource.data.toUid == 'ADMIN_BROADCAST' && isAdmin())
      );
      allow read, delete: if isAdmin();
    }

    match /notifications_log/{logId} {
      allow read: if isAccountantAdmin();
      allow write: if isAdmin();
    }
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isMarketingAdmin();
    }
    match /config/{configId} {
      allow read, write: if isSuperAdmin();
    }
    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }
    match /scheduled_notifications/{notifId} {
      allow read, write: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
