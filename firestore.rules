rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // Single get() (rules cache same-path reads) — the EFFECTIVE role.
    // SECURITY: staff docs store their real sub-role in `staff_role` while `role`
    // stays the generic 'admin'. Preferring staff_role makes isOrdersManager/
    // isMarketingAdmin/isAccountantAdmin/isSuperAdmin actually separate staff
    // (previously every staff member = 'admin' = full super_admin). Bootstrapped
    // super admins have no staff_role, so they fall back to `role` and stay super.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function getUserRole() {
      return getUserData().get('staff_role', getUserData().get('role', 'client'));
    }

    // ⚠️ **STAGE-C — مُعلَّقٌ مع أخواتِه حتى يُفرَضَ الحدُّ الأدنى للإصدار.**
    //
    // مفتاحُ «إيقافِ موظّف» في `admin_managers_screen` كان يَكتبُ
    // `admins/{id}.is_active` **ولا قارئَ لذلك الحقلِ في المستودعِ كلِّه**:
    // لا هذه القواعدُ، ولا الدوالُّ، ولا `getUserRole` في العميل. فموظّفٌ
    // تُظهِرُه الشاشةُ «معطّلاً» يَدخلُ ويَعملُ بكلِّ ما يُجيزُه دورُه —
    // وهو مفتاحٌ يَستعملُه المالكُ **بدلَ الحذف** لأنّه يَبدو أهونَ.
    //
    // الشرطُ هنا يُقرأُ من `users` — المستندُ المُحمَّلُ أصلاً في
    // `getUserData()` — فلا قراءةَ ثانيةً ولا كلفةَ. والغيابُ = مُفعَّل،
    // لأنّ مستنداتَ الإنتاجِ القائمةَ لا تَحملُ الحقل.
    //
    // ومحصورٌ في مُعيِّناتِ **الموظّفينَ** عمداً: `is_active` على مستندِ
    // عميلةٍ أو سائقٍ لا معنى له هنا (حالةُ السائقِ تُقرأُ من
    // `drivers/{id}` عبر `isAssignableDriver` خادميّاً)، فإدخالُه في
    // `getUserRole()` نفسِها كان سيَطرُدُ عميلاتٍ لحقلٍ كُتبَ لسببٍ آخر.
    function staffEnabled() {
      return getUserData().get('is_active', true) != false;
    }

    // Any admin role
    function isAdmin() {
      return isLoggedIn() && staffEnabled() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        getUserRole() in ['admin', 'super_admin', 'orders_manager',
                          'accountant_admin', 'marketing_admin']
      );
    }

    // Orders + drivers management
    function isOrdersManager() {
      return isLoggedIn() && staffEnabled() &&
        getUserRole() in ['admin', 'super_admin', 'orders_manager'];
    }

    // Financial read access
    function isAccountantAdmin() {
      return isLoggedIn() && staffEnabled() &&
        getUserRole() in ['admin', 'super_admin', 'accountant_admin'];
    }

    // Marketing content management
    function isMarketingAdmin() {
      return isLoggedIn() && staffEnabled() &&
        getUserRole() in ['admin', 'super_admin', 'marketing_admin'];
    }

    // Destructive operations: delete users, change system config
    function isSuperAdmin() {
      return isLoggedIn() && staffEnabled() &&
        getUserRole() in ['admin', 'super_admin'];
    }

    // ─── أعلامُ الثقةِ الخادميّةِ: قائمةٌ واحدةٌ لمجموعتَي الطلبات ──────────
    //
    // **القاعدةُ كانت على سطحٍ واحدٍ من اثنَين (2026-10-05).** قائمةُ منعِ
    // الإنشاءِ في `orders` بلغَت ٦١ اسماً، و`store_orders` كانت تَمنعُ
    // **اسمَين** — بينما `_verifyStoreOrderPrice` يَكتبُ على طلبِ المتجرِ
    // الأعلامَ نفسَها بحروفِها: `price_mismatch`، `price_unverifiable`،
    // `price_paid`، `price_expected`، `price_shadow_ratio`،
    // `ops_alerted_mismatch`، `ops_alerted_unverifiable`. فكلُّ ما حُجِبَ
    // هناك كان مكشوفاً هنا.
    //
    // فالقائمةُ تَسكنُ مرّةً ويُنادِيها الموضعان، بدلَ نسخةٍ ثانيةٍ لا
    // يَحفظُها إلّا التذكُّر — ونسخةٌ ثانيةٌ تَنحرِف، وهو ما تَكرّر في هذا
    // المستودعِ مرّاتٍ (مرايا اللوحة، `isAssignableDriver` في اثنَين من
    // أربعة). و`moyasar_payment_id` **فيها**: ظنَنتُ أوّلاً أنّ العميلَ
    // يَكتبُه شرعاً عند بدءِ الدفعِ فأبقيتُه خاصّاً بالمتجر، وفحصُ «لا كاتبَ
    // عميليّاً» أسقطَ ذلك الظنَّ — صفرُ كاتبٍ في `lib/` واللوحة. وأثرُ
    // غيابِه مشروحٌ عند اسمِه أدناه: سلّةٌ غيرُ مدفوعةٍ تَصيرُ خالدة.
    function serverTrustFlags() {
      return [
        'needs_refund', 'refund_credited', 'rewards_handled_by',
        'qatrat_granted', 'visit_counted', 'coupon_counted', 'paid_confirmed',
        // SECURITY: الإسناد قرار خادمي/إداري حصراً — عميلٌ يكتب driver_id عند الإنشاء
        // كان يزرع سائقاً من اختياره في مهامّه ويتجاوز محرّك التوزيع (لا مسار شرعي
        // في التطبيق يكتبه عند الإنشاء).
        'driver_id',

        // ⚠️ **أعلامُ الثقةِ الخادميّةُ (2026-10-05).** كانت القائمةُ ثمانيةً،
        // وبقيةُ أعلامِ الخادمِ مكشوفةً للإنشاء — **وواحدٌ منها يُسكِتُ
        // التنبيهَ الوحيدَ لمسارِ المحفظة**:
        //
        // `opsHealthSweep` يُنبّه عبر `alertBatch(docs, 'ops_alerted_mismatch')`،
        // وهي **تُسقِطُ كلَّ مستندٍ العلمُ فيه `true` سلفاً** («نبّهنا عنه»).
        // ومسارُ المحفظةِ يَسِمُ `price_mismatch` **بصمتٍ** ويَتّكلُ على هذا
        // المسحِ وحدَه (تعليقُه في `index.js` يَقولُه: «مسار المحفظة يَسِم
        // بصمت فيغطيه الفحص الدوري»). فعميلةٌ تُنشئُ طلبَها بـ
        // `ops_alerted_mismatch: true` ثمّ تَدفعُ من المحفظةِ أقلَّ من نصفِ
        // السعرِ وفوقَ خُمسِه (فلا يُرفَض): تُخدَم، ويُوسَمُ الطلبُ، **ولا
        // يُنبَّهُ أحدٌ أبداً**.
        //
        // والثلاثةُ الأخرى من عائلةِ `alertBatch` نفسِها، و`tamper_handled`
        // هو حجزُ Tier B (ضبطُه سلفاً يَجعلُ `voidOrRefundTampered` تُعيد
        // «already» بلا نداءِ البوّابة)، و`final_amount` يَتقدّمُ تدرّجَ
        // المبالغِ كلَّه في `amounts.js`.
        //
        // ولا كاتبَ شرعيّاً لأيٍّ منها في العميل: صفرُ كتاباتٍ في `lib/`
        // للثمانيةِ، و`final_amount` ١٤ قراءةً بلا كتابة.
        'ops_alerted_mismatch', 'ops_alerted_noshow',
        'ops_alerted_paid_awaiting', 'ops_alerted_stuck',
        // و`ops_alerted_unverifiable` عضوٌ خامسٌ في العائلةِ نفسِها (أُضيف
        // مع مكنسةِ «تعذّر التحقّق»)، و`price_paid` هو الرقمُ الذي تَعرضُه
        // بطاقةُ المراجعةِ للإدارة — فكتابتُه عميليّاً تَكذبُ على من يُقرّر.
        'ops_alerted_unverifiable', 'price_paid',
        'tamper_handled', 'tamper_blocked',
        'price_mismatch', 'price_unverifiable', 'price_expected',
        'price_expected_net', 'price_shadow_ratio',
        'auto_refund_processed', 'auto_refund_alerted', 'stranded_alerted',
        'coupon_rejected_reason', 'final_amount',
        // وأعلامُ إعادةِ المحاولةِ الخادميّةِ كأخواتِها: ضبطُها سلفاً
        // يُعطّلُ المكنسةَ التي تَستعلمُها (`refund_credit_alerted` يُسكِتُ
        // تصعيدَ استردادٍ فاشل، و`qatrat_pending`/`coupon_count_pending`
        // تُدخِلانِ طلباً سليماً في مجموعةِ إعادةِ المحاولة).
        'refund_credit_failed', 'refund_credit_alerted',
        'qatrat_pending', 'qatrat_alerted',
        'coupon_count_pending', 'coupon_count_alerted',
        // وتسويةُ رصيدِ زياراتِ الاشتراك (2026-10-05): `..._pending`
        // يُدخِلُ طلباً سليماً في مجموعةِ إعادةِ المحاولة، و`..._alerted`
        // يُسكِتُ التنبيهَ الوحيدَ على فشلِ خصمِ زيارةٍ مستهلَكةٍ أو ردِّ
        // زيارةٍ مدفوعة. (و`visit_counted` نفسُه ممنوعٌ أعلاه — فضبطُه
        // سلفاً كان يَعني زيارةً مجّانيّة.)
        'visit_accounting_pending', 'visit_accounting_alerted',
        // ومكافأةُ الإحالة: `..._pending` يُدخِلُ طلباً سليماً في
        // مجموعةِ إعادةِ المحاولة، و`..._alerted` يُسكِتُ التنبيهَ على
        // ضياعِ ٥٠ ر.س للمُحيلِ وكوبونِ المُحالة.
        //
        // والصرفُ المزدوجُ مسدودٌ بغيرِ هذه القائمة: المِقصَلةُ هي
        // `referrals/{id}.status == "pending"` **داخلَ المعامَلة**،
        // و`referrals` كلُّها `allow write: if false` فلا يَمَسُّها عميل.
        // (أمّا `referral_processed` على الطلبِ فمَكتوبٌ ولا قارئَ له في
        // المستودعِ كلِّه — فتلفيقُه لا يُغيّرُ شيئاً، ومنعُه زينةٌ.)
        'referral_payout_pending', 'referral_payout_alerted',
        // وتجميعُ التقييم: `rating_agg_pending` يُدخِلُ طلباً سليماً في
        // مجموعةِ إعادةِ المحاولة، و`..._alerted` يُسكِتُ التنبيه.
        // و`rating_aggregated` هو مانعُ التكرارِ الجديد: ضبطُه سلفاً
        // يُسقِطُ تقييمَها من متوسّطِ السائقِ — لا مصلحةَ لها فيه
        // (تَكتمُ تقييمَها نفسَه) فالمنعُ اتّساقٌ لا سدُّ هجوم، وتحديثُها
        // محصورٌ بـ`hasOnly` لحقولِ التقييمِ فلا تَبلغُه بعد الإنشاءِ أصلاً.
        'rating_agg_pending', 'rating_agg_alerted', 'rating_aggregated',
        // وعلمُ «أُخبِرَت العميلةُ بتأخّرِ فريقِها»: مكنسةُ الإسنادِ
        // تَستعلمُه كأخواتِه، فضبطُه سلفاً يُسكِتُ الدفعةَ الوحيدةَ التي
        // تُخبرُها أنّ موعدَها فاتَ بلا فريق. لا كاتبَ له في `lib/` ولا
        // مصلحةَ لعميلةٍ في إسكاتِ إشعارِ نفسِها — فالمنعُ اتّساقٌ مع
        // العائلةِ لا سدُّ هجوم.
        'client_stranded_notified',
        // وقرارُ مراجعةِ السعرِ قرارٌ إداريٌّ موقَّعٌ باسمِ من اتّخذَه —
        // عميلةٌ تُنشئُ طلبَها بـ`price_review_decision: 'approved'` تَكتبُ
        // شهادةً لم يُوقّعها أحد.
        'price_review_decision', 'price_reviewed_by', 'price_reviewed_at',
        // ⚠️⚠️ **وعلَمٌ واحدٌ يُطفئُ تحقّقَ السعرِ على مسارٍ كاملٍ وينزعُ
        // الإنفاذَ عن المسارِ الآخر (2026-10-05).** كاتبُه الشرعيُّ
        // `verifyMoyasarPayment` حين **يُنشئُ الخادمُ الطلبَ بنفسِه** من
        // بيانات الدفع (مسارُ Apple Pay / الدفعِ الأصليّ)، فالمبلغُ لم
        // يُعلِنْه العميلُ أصلاً. وهو مقروءٌ في موضعَين يَقرّرانِ المال:
        //
        //   • `_tamaraFlipPaid`:  `if (col === "orders" &&
        //     !data.server_created_from_payment) { … _verifyOrderPriceTierA }`
        //     — فضبطُه سلفاً يُسقِطُ **تحقّقَ Tier A كلَّه** على مسارِ
        //     تمارا: لا إعادةَ تسعيرٍ من المنطقة، ولا وسمَ
        //     `price_mismatch`، ولا تنبيهَ إدارة.
        //   • Tier B: `const egregious = … && od.server_created_from_payment
        //     !== true;` — فضبطُه سلفاً يَنزعُ الإنفاذَ (الإلغاء/الاسترداد)
        //     عن الطلبِ المُتلاعَبِ به على مسارِ ميسر.
        //
        // أي أنّ بوليانيّاً واحداً يَكتبُه العميلُ عند الإنشاءِ يَدّعي
        // «الخادمُ أنشأني» فيَشتري الإعفاءَ من الفحصَين. صفرُ كتاباتٍ له
        // في `lib/` واللوحة.
        // و`reconciled` يُكتَبُ على السطرِ نفسِه في `reconcileOrphanPayments`
        // علامةَ مصدرٍ كذلك — لا قارئَ له اليوم، فمنعُه اتّساق.
        'server_created_from_payment', 'reconciled',

        // ⚠️ **وعلَمٌ يُسكِتُ الكاشفَ المكتوبَ للتلاعبِ الذي يُسمّيه (2026-10-05).**
        // `_flagZoneGeoMismatch` في `index.js` يَقولُ في ترويسةِ نفسِه:
        // «المنطقة تُحَلّ باسم يرسله العميل (zone_name) بلا أي تحقّق أن
        // الموقع فعلاً داخلها — عميلٌ في منطقة أغلى يمكنه إرسال اسم منطقة
        // أرخص». فهو يَقيسُ المسافةَ من مركزِ المنطقةِ المُعلَنة، وعند
        // تجاوزِ نصفِ القطرِ بهامشِ ٢٠٪ يَسِمُ الطلبَ ويُنبّهُ الإدارة.
        // وأوّلُ سطرٍ فيه: `if (od.zone_geo_mismatch === true) return null;`
        // — فعميلةٌ تُنشئُ طلبَها بهذا العلمِ تُسقِطُ الكاشفَ كلَّه: **لا
        // وسمَ ولا تنبيه**، وتَدفعُ سعرَ المنطقةِ الأرخص. وهي عائلةُ
        // `ops_alerted_mismatch` بعينِها (علَمٌ يَعني «فُحِصَ سلفاً»).
        // و`zone_geo_distance_m` هو رقمُ البيّنةِ الذي يَقرؤه مَن يُراجِع.
        'zone_geo_mismatch', 'zone_geo_distance_m',
        // وما تحتَ هذا السطرِ **اتّساقٌ لا سدُّ هجوم**، ويُقالُ كذلك:
        // `payment_amount_mismatch` و`coupon_rejected` (العلمُ البولياني،
        // أمّا `coupon_rejected_reason` فممنوعٌ أعلاه وهو المقروء)
        // و`auto_refund_failed` و`refund_after_assign_conflict` — **لا
        // قارئَ لأيٍّ منها في المستودعِ كلِّه** (فُحِصَ `functions/` و`lib/`
        // واللوحة)، فتلفيقُها لا يُغيّرُ سلوكاً اليوم؛ ومنعُها يَجعلُ
        // إعطاءَها قارئاً غداً آمناً بلا تذكُّر. و`refund_claimed` **يُقرأُ**
        // حجزاً ذرّيّاً داخلَ معامَلةِ الاسترداد، لكنّ كاتبَه عند الإنشاءِ
        // هو المالكُ وحدَه (القاعدةُ تَشترطُ `client_id == uid`) فلا يَضرُّ
        // إلّا استردادَ نفسِه — ضررٌ بلا مكسب، ويَبقى علمَ ثقةٍ خادميّاً.
        'payment_amount_mismatch', 'coupon_rejected', 'coupon_overlimit',
        'auto_refund_failed', 'refund_after_assign_conflict',
        'tamper_gateway_failed', 'reopened_after_late_payment',
        'refund_claimed', 'refund_claimed_at',
        // ⚠️ **و`moyasar_payment_id` يُخلِّدُ سلّةً غيرَ مدفوعة (2026-10-05).**
        // `cancelStaleUnpaidOrders` يُلغي الطلبَ المعلَّقَ غيرَ المدفوعِ بعد
        // ثلاثينَ دقيقةً، وله استثناءٌ صريحٌ: `if (d.moyasar_payment_id)
        // continue;` — أيُّ قيمةٍ صادقةٍ تُعفي. والحقلُ **خادميٌّ خالصٌ**:
        // أربعةُ كُتّابٍ في `functions/index.js` وصفرُ كاتبٍ في `lib/` أو
        // اللوحة (ثلاثُ قراءاتٍ فقط: سجلُّ الفواتيرِ وشاشةُ الطلبِ الإداريّة).
        // فعميلةٌ تُنشئُ طلباً بـ`moyasar_payment_id: "x"` تَجعلُه **خالداً**:
        // لا يُلغى أبداً، فيَبقى في طابورِ ما ينتظرُ قراراً إداريّاً وفي
        // بلاطةِ «الطلبات المجدولة» عند المالك (`admin_insights_screen`
        // تَعُدُّ `kPreDispatchStatuses` بلا سائق) إلى الأبد — وهي المكنسةُ
        // الموجودةُ أصلاً كي لا تَتراكمَ السلالُ المتروكة. ولا مالَ فيها ولا
        // سائقَ: `capacity.countBookings` يَتخطّى غيرَ المدفوع، و`pending`
        // خارجُ `CONFLICT_STATUSES` بقصد — فهي تراكمٌ وتضخيمُ عدّادٍ لا خصم.
        // وكان خارجَ القائمةِ لظنٍّ أنّ العميلَ يَكتبُه عند بدءِ الدفع.
        // وعلَمُ إعادةِ فكِّ الإسناد: ضبطُه سلفاً يُدخِلُ طلبَها في نافذةِ
        // المكنسةِ فيُكتَبُ عليه `unassigned_reason: "driver_disabled"` بلا
        // سائقٍ معطَّلٍ أصلاً — لا ضررَ ماليَّ (الطلبُ عند الإنشاءِ بلا
        // سائق) لكنّ اتّساقَ القائمةِ أرخصُ من استثناءٍ يُشرَح.
        'unassign_pending', 'unassign_driver_id',
        'moyasar_payment_id',
        // وأعلامُ تكرارِ الإشعار: ضبطُها سلفاً يَمنعُ تذكيرَها بموعدِها
        // أو دفعةَ تأكيدِ دفعِها — ضررُها على نفسِها، والإدارةُ وحدَها
        // تُصفّرُها عند تغييرِ الموعد (وذاك `update` لا `create`).
        'client_reminder_24h_sent', 'client_reminder_soon_sent',
        'reminder_sent', 'payment_push_sent',
      ];
    }


    // ─── User Profiles ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // SECURITY: privileged accounts are provisioned by an admin (createAccountViaAdmin
      // writes the users doc under the admin's auth); a regular user may only create their
      // own profile and can never self-assign a privileged role.
      allow create: if
        // Super admin: provision any account (staff / drivers)
        isSuperAdmin() ||
        // Orders manager: may provision driver accounts only (not other admins),
        // and never a privileged staff_role (blocks escalation via sub-provisioning)
        (isOrdersManager() &&
          request.resource.data.get('role', 'client') == 'driver' &&
          request.resource.data.get('staff_role', 'client') == 'client') ||
        // Self-signup: own doc, non-privileged role AND non-privileged staff_role only.
        // SECURITY: getUserRole() trusts staff_role BEFORE role, so it must be guarded
        // here too — otherwise a client self-signs with staff_role='super_admin'.
        (isOwner(userId) &&
          !(request.resource.data.get('role', 'client') in
            ['admin', 'super_admin', 'orders_manager',
             'accountant_admin', 'marketing_admin', 'driver']) &&
          request.resource.data.get('staff_role', 'client') == 'client');

      // SECURITY: only super_admin may set role/is_blocked (prevents a sub-admin from
      // self-escalating to super_admin or blocking users); the `wallet` field on the
      // user doc is never client-writable (the real balance lives in /wallets, server-only).
      allow update: if
        // Super admin: create staff/drivers (role), ban users (is_blocked) — but not wallet
        (isSuperAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet'])) ||
        // Other admins: edit user profile fields, but never role / staff_role / wallet /
        // is_blocked / visits_remaining. SECURITY: staff_role IS the effective role
        // (getUserRole trusts it first), so only a super_admin may set it — a sub-admin
        // must not self-escalate. visits_remaining is a prepaid subscription-credit
        // counter (server-managed) and must not be granted outside payment.
        // SECURITY: `status` هو علم الحظر الثاني (user_provider يطرد status=='banned') —
        // الحظر/رفعه قرار للمدير العام وحده، أسوةً بـ is_blocked.
        (isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'staff_role', 'wallet', 'is_blocked', 'status',
                     'visits_remaining'])) ||
        // Owner: own non-sensitive fields only. visits_remaining / subscription credits
        // are server-only (they represent paid subscription visits — never client-writable).
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            // SECURITY: `status` محظور على المالك أيضاً — وإلا رفع المحظور حظره بنفسه
            // بكتابة status:'active' (user_provider يفحص status=='banned').
            .hasAny(['role', 'staff_role', 'wallet', 'rating_avg', 'rating_count',
                     'total_orders', 'is_blocked', 'status', 'visits_remaining',
                     'subscription_expiry', 'subscription_total_visits',
                     // خادمية فقط (activateContractOnPaid) — منعُ تزييف بطاقة اشتراك.
                     'has_active_subscription', 'subscription_type',
                     // SECURITY: رابطُ الإحالة يكتبه `applyReferralCode` وحده
                     // (Admin SDK). لو كتبها المالك بنفسه نسب إحالتَه لمن يشاء —
                     // والمكافأة 50 ر.س تُصرف على `referrals.referrer_id` الذي
                     // يُشتقّ من هذه القراءة.
                     'used_referral_code', 'referred_by']) &&
          // SECURITY: `referral_code` **يُكتب مرّةً واحدة**.
          //
          // `getOrCreateReferralCode` يولّده من العميل ويكتبه على مستنده، فلا
          // يمكن منعُه كلّيّاً. لكنّ `applyReferralCode` يحلّ المُحيلَ بـ
          // `where('referral_code','==',code).limit(1)` — فمن يستطيع **تغيير**
          // كوده يضبطه على كود غيره، فتُرجِع الاستعلامةُ أحدَ المستندَين، وقد
          // تُنسب إحالةٌ (ومكافأتُها) إلى غير صاحبها. الكتابةُ مسموحةٌ ما دام
          // الحقلُ غائباً أو فارغاً، وممنوعةٌ بعد ذلك.
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['referral_code']) ||
           resource.data.get('referral_code', '') == '') &&
          // SECURITY: `email` على السجلّ يَجبُ أن يُطابقَ بريدَ **المصادقة**.
          //
          // `isAllowedEmailRecipient` يَستعلمُ `users.where('email','==',…)`
          // ليُجيزَ وجهةَ بريدٍ، وحارسُ المُرسِلِ كان يُقارِنُ هذا الحقلَ
          // نفسَه بـ`recipientEmail` ليُجيزَ «عميلٌ يُرسلُ لبريدِه». فمن
          // يَكتبُ بريدَه `victim@x.com` يَجتازُ الحارسَين ويُرسلُ بريداً
          // من `no-reply@zyiarah.com` بمحتوًى من اختيارِه إلى أيِّ عنوان.
          // (الحارسُ الخادميُّ صار يَقرأُ بريدَ المصادقة، وهذا دفاعٌ ثانٍ
          // ويُبقي السجلَّ صادقاً لاستعلامِ الوجهة.) المسارُ الشرعيُّ
          // الوحيدُ — تحديثُ التسجيل في `firebase_service` — يَكتبُ البريدَ
          // الذي سُجِّل به، أي بريدَ المصادقةِ عينَه.
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['email']) ||
           request.resource.data.email == request.auth.token.email));

      allow delete: if isSuperAdmin();
    }

    // ─── Accountants ──────────────────────────────────────────────────────
    match /accountants/{accountantId} {
      allow read: if isOwner(accountantId) || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isOwner(accountantId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'is_active', 'email']));
    }

    // ─── Account Deletion Requests ────────────────────────────────────────
    // SECURITY: the doc ID IS the target uid, and onAccountDeletionRequested deletes
    // that auth user + users doc when status=='deleted'. A caller may therefore ONLY
    // request deletion of their OWN account — otherwise any user could wipe any other
    // account (including admins) by writing account_deletions/{victimUid}.
    match /account_deletions/{deletionId} {
      // super admin يحذف مستخدماً آخر عبر كتابة الطلب هنا → processAccountDeletion يحذف
      // حساب Auth + مستند users + رموز FCM. كان حذف الأدمن يمسح مستند users فقط ويترك
      // حساب Auth حيّاً قابلاً للدخول. (العميل يحذف حسابه هو فقط — isOwner.)
      allow create: if isOwner(deletionId) || isSuperAdmin();
      allow read, update, delete: if isSuperAdmin();
    }

    // ─── Support Tickets ──────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isLoggedIn() && (
          request.auth.uid ==
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
          || isAdmin()
        );

        // ⚠️⚠️ **ردٌّ مُلفَّقٌ باسمِ «فريق زيارة» يُسكِتُ تنبيهَ الدعمِ عن
        // نفسِه (2026-10-05).** كان `create` بلا قيدٍ على **المحتوى**: مالكةُ
        // التذكرةِ تُنشئُ رسالةً بأيِّ حقول. وأربعةُ قُرّاءٍ يُقرّرونَ «أهذا
        // منّا أم منها؟» من حقلَين تَكتبُهما هي:
        //
        //   • `sendNotificationOnTicketReply` (خادميّ): يَتفرّعُ على
        //     `senderRole === "admin" || senderId === "admin"` — فالفرعُ
        //     الأوّلُ «ردُّ الدعم ⇒ أشعِرْ صاحبةَ التذكرة»، والثاني «ردُّ
        //     العميلةِ ⇒ أشعِرِ الإدارة». فرسالةٌ تَحملُ الادّعاءَ **تُسقِطُ
        //     تنبيهَ «رد جديد على تذكرة دعم» عن مديرِ الطلباتِ كلَّه**: تَكتبُ
        //     إلى الدعمِ ولا يُخبَرُ أحد، وتُرسِلُ إلى نفسِها «تم الرد على
        //     تذكرتك 💬».
        //   • `Support.tsx` و`admin_ticket_details_screen`: يَرسمانِ الرسالةَ
        //     **في جهةِ الفريقِ** بنصِّها، فالخيطُ يُقرأُ عند الأدمنِ كأنّ
        //     الفريقَ أجابَ — ونصُّها من اختيارِها («تم استرداد المبلغ كاملاً»).
        //     وهي عائلةُ حقنِ HTML في بريدِ التنبيهِ الإداريِّ: محتوى العميلةِ
        //     يُعرَضُ على المالكِ بسلطتِنا.
        //
        // فالمالكةُ تُنشئُ بحقولِ التطبيقِ وحدَها، و`senderRole` إن كُتِبَ
        // فـ`user`، و`senderId` إن كُتِبَ فهو uid نفسِها. والإداريُّ بلا قيد.
        // (مُثبَتٌ على المُحاكي: بالقاعدةِ القديمةِ يَنجحُ التلفيقُ.)
        allow create: if isAdmin() || (
          isLoggedIn()
          && request.auth.uid ==
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
          && request.resource.data.keys()
              .hasOnly(['senderId', 'senderRole', 'text', 'sentAt'])
          && request.resource.data.get('senderRole', 'user') == 'user'
          && request.resource.data.get('senderId', request.auth.uid)
              == request.auth.uid
        );
      }
    }

    // Legacy tickets collection
    match /tickets/{ticketId} {
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.driver_id ||
        isAdmin()
      );

      // SECURITY: client_id must match caller; initial status limited to safe entry states.
      // ⚠️ المرحلة C من ترحيل الدفع: العميل لا ينشئ طلباً مدفوعاً (is_paid=true) ولا يكتب
      // أي حقل ثقة خادمي عند الإنشاء — is_paid يقلبه الخادم فقط (verifyMoyasarPayment /
      // payWithWallet / webhooks). يُغلق سكّ المحفظة. **لا تُنشَر إلا بعد انتشار التطبيق
      // الجديد (ينشئ is_paid=false) وفرض الحد الأدنى للإصدار** — وإلا تنكسر مدفوعات النسخ
      // القديمة. (STAGE-C — DO NOT DEPLOY UNTIL THE NEW APP IS THE MINIMUM VERSION.)
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid &&
        request.resource.data.get('status', 'pending') in
          ['pending', 'awaiting_payment'] &&
        request.resource.data.get('is_paid', false) == false &&
        !request.resource.data.keys().hasAny(serverTrustFlags());

      // Orders manager: full update (approve, assign driver -> scheduled, override status)
      allow update: if isOrdersManager();

      // Driver (Direct Dispatch): may ONLY advance an assigned task forward + sync location.
      // No accept/reject, no self-reassignment, no identity/amount tampering, and — since
      // cash-on-delivery was removed at the root — NO payment fields at all: a driver can
      // no longer mark an order paid. Payment is always upfront and confirmed server-side
      // (webhook / verifyMoyasarPayment / payWithWallet).
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.driver_id &&
        resource.data.status in ['scheduled', 'on_the_way', 'in_progress', 'accepted'] &&
        // إمّا تبقى الحالة كما هي (كتابة موقع/قرب لا تغيّرها — كان طلب 'accepted'
        // يُرفَض صامتاً فتتجمّد خريطة العميل)، أو تتقدّم للأمام فقط. صياغة «البقاء
        // أو التقدّم» أدقّ من قائمةٍ ثابتة: تغطّي كتابة الموقع في أي حالة نشطة،
        // وتمنع الرجوع للخلف (in_progress → accepted) الذي تسمح به قائمةٌ صرفة.
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status in ['on_the_way', 'in_progress', 'completed']) &&
        // 'rewards_handled_by' مسموح: تكتبه عند الإكمال ليعالج الخادم الجوائز (onOrderRewards)
        // 'completed_distance_m' مسموح: يكتبه driver_dashboard عند الإكمال متى توفّر GPS.
        //   كان غائباً عن هذه القائمة، و hasOnly ترفض **المعاملة كاملة** لأي مفتاح خارجها —
        //   أي أن إكمال الطلب كان يفشل لدى كل سائق يعمل GPS جهازه، بينما ينجح لمن لا يعمل.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'on_the_way_at', 'arrived_at', 'start_time', 'end_time',
          'driver_location', 'last_location_update', 'updated_at',
          'completed_distance_m',
          'rewards_handled_by', 'proximity_notified'
        ]) &&
        // (#43) مرساة زمنية موثوقة: إن كُتب start_time/end_time فيجب أن يساوي request.time.
        // كتابة FieldValue.serverTimestamp() تُحلّ إلى request.time فتمرّ؛ أي قيمة حرفية
        // مزوَّرة تُرفَض — فلا يزوّر السائق مدّة الخدمة (يعتمد عليها لون التخطّي وشارات الإدارة).
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['start_time']) ||
          request.resource.data.start_time == request.time) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['end_time']) ||
          request.resource.data.end_time == request.time);

      // Client: cancel own pending order, update invoice URL, or submit rating
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.client_id &&
        (
          // 1. Cancellation flow — only before the task is dispatched to a driver
          (resource.data.status in ['pending', 'awaiting_payment'] &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelled_at', 'cancelled_by', 'needs_refund', 'rewards_handled_by']) &&
           request.resource.data.status == 'cancelled' &&
           // `needs_refund` مربوطٌ بالواقع لا بإرادةِ الكاتب: التطبيقُ
           // الشريفُ يَكتبُ `is_paid == true` بعينِه (`order_service.cancelOrder`
           // و`Orders.tsx` كلاهما)، لكنّ كتابةً مباشرةً من الـSDK كانت تَضَعُ
           // `true` على طلبٍ **غيرِ مدفوع**. ولا مالَ فيها (كِلا قارئَي العلم
           // — المُشغّلُ والمكنسةُ — يَشترطُ `is_paid === true`)، لكنّ
           // المستندَ يَشغلُ خانةً من نافذةِ المكنسةِ ذاتِ الـ200 **إلى
           // الأبد**، فيُزحزحُ استرداداً فاشلاً حقيقيّاً بترتيبِ `__name__`
           // العشوائيّ: صمتٌ تامّ. و`.get` لا القوسُ المباشر، لأنّ طلباً
           // قديماً قد لا يَحملُ الحقلَ أصلاً وقراءةُ غائبٍ تَرفضُ الكتابة.
           request.resource.data.needs_refund ==
             resource.data.get('is_paid', false))
          ||
          // 2. Invoice PDF URL update flow — يشمل invoice_pdf_status: مولّد
          //    الفاتورة يكتب حالة إعادة المحاولة، وكانت خارج القائمة فتُرفض
          //    المعاملة كاملة ويتعطل مسار إعادة توليد الفاتورة.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['invoice_pdf_url', 'invoice_pdf_status']))
          ||
          // 3. Rating flow (only allowed once rating is not already set)
          (resource.data.get('rating', null) == null &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rating', 'rating_comment', 'rating_reason', 'rating_evidence_url', 'rated_at']))
        );

      allow delete: if isSuperAdmin();
    }

    // ─── Drivers ──────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == driverId || isAdmin());
      allow write: if isOrdersManager();
      // Driver can update own availability/location — not financial or identity fields
      allow update: if isLoggedIn() &&
        request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['name', 'phone', 'monthly_salary', 'wallet',
                   'rating_avg', 'rating_count', 'rides', 'email',
                   'id_number', 'id_expiry', 'nationality']);
    }

    // ─── FCM Tokens ───────────────────────────────────────────────────────
    // SECURITY: the `role` field on a token drives ADMIN_BROADCAST fan-out. A user must
    // not tag their own device with a privileged role to eavesdrop on admin pushes, so a
    // self-write must carry the caller's real users/{uid}.role (exactly what the app writes).
    // Delete is unrestricted for owner/admin so sign-out cleanup still works.
    match /fcm_tokens/{tokenId} {
      allow read, delete: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
      allow create, update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == tokenId &&
          request.resource.data.get('role', 'client') == getUserData().get('role', 'client') &&
          // SECURITY: لا يجوز وسم الجهاز بدور فرعي إداري لا يملكه المستخدم — توجيه
          // ADMIN_BROADCAST يفلتر على staff_role، فتركُه دون قيد كان يتيح التنصّت.
          request.resource.data.get('staff_role', null) == getUserData().get('staff_role', null)));
    }
    match /fcm_token/{tokenId} {
      allow read, delete: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
      allow create, update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == tokenId &&
          request.resource.data.get('role', 'client') == getUserData().get('role', 'client') &&
          // SECURITY: لا يجوز وسم الجهاز بدور فرعي إداري لا يملكه المستخدم — توجيه
          // ADMIN_BROADCAST يفلتر على staff_role، فتركُه دون قيد كان يتيح التنصّت.
          request.resource.data.get('staff_role', null) == getUserData().get('staff_role', null)));
    }

    // ─── Wallets & Transactions ───────────────────────────────────────────
    // SECURITY: الرصيد والمعاملات تُكتب حصرياً من Cloud Functions عبر Admin SDK
    // (payWithWallet / redeemQatratPoints / onOrderRewards) — لا كتابة من العميل.
    match /wallets/{walletId} {
      allow read: if isLoggedIn() && (request.auth.uid == walletId || isAdmin());
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isLoggedIn() && (request.auth.uid == walletId || isAdmin());
        allow write: if false;
      }
    }

    // ─── Contracts (subscriptions) ────────────────────────────────────────
    // SECURITY: userId must match caller on create, and the owner can NEVER self-set a
    // paid/active status or plan/visits fields. generateSubscriptionVisits mints paid
    // (is_paid=true) visit-orders once a contract is 'active'; without this guard any
    // client could activate their own contract and get free subscription visits.
    // Activation/payment must be server- or admin-gated (mirrors the Stage-C order model).
    match /contracts/{contractId} {
      // SECURITY (CRITICAL): العقد ينشئه العميل موقَّعاً بحقول planPrice/planVisits من
      // الواجهة، والخادم يحاسبه على planPrice كما هو (verifyMoyasarPayment /
      // payContractWithWallet تقرآن planPrice من المستند). لا يمكن للقواعد مطابقة السعر
      // مع subscription_packages (لا معرّف باقة على العقد)، فنحصر الإنشاء في الشكل
      // الشرعي الوحيد (contract_signing_screen): status=='pending'، غير مدفوع، أرقام
      // موجبة، وبلا أي حقل ثقة خادمي (التفعيل/التوليد/الأرصدة يكتبها الخادم فقط).
      // ⚠️ الحسم النهائي لسعر الباقة يبقى تحققاً خادمياً (انظر تقرير التدقيق).
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('is_paid', false) == false &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('planPrice', 0) is number &&
        request.resource.data.get('planPrice', 0) > 0 &&
        request.resource.data.get('planVisits', 0) is number &&
        request.resource.data.get('planVisits', 0) > 0 &&
        !request.resource.data.keys().hasAny([
          'paid_confirmed', 'visits_generated', 'visits_generated_at',
          'activatedAt', 'activated_at', 'adminApprovedAt', 'paid_at',
          'visits_remaining', 'visits_total', 'expiry', 'amount',
          // ⚠️ **أعلامُ التفعيلِ والتوليدِ وإعادةِ المحاولة (2026-10-05).**
          // `contract_visits_pending` هو ما تَستعلمُه مكنسةُ إعادةِ توليدِ
          // الزيارات، و`_generateContractVisits` يُنشئُ زياراتٍ بـ
          // `is_paid: true` و`amount: 0` بعددِ `planVisits` الذي يَكتبُه
          // العميلُ — فضبطُه سلفاً على عقدٍ غيرِ مدفوعٍ كان سيَكونُ **خدمةً
          // مجّانيّةً بعددٍ يَختارُه**. (المكنسةُ تَشترطُ `is_paid == true`
          // كذلك، وهو الحارسُ العاملُ فعلاً ما دامت القواعدُ محجوزةً.)
          'contract_visits_pending', 'contract_visits_error',
          'contract_visits_alerted',
          'contract_activation_failed', 'contract_activation_error',
          // ووسمُ فشلِ تحقّقِ الباقة: صارَ له قارئٌ في شاشةِ العقودِ
          // الإداريّة، فتلفيقُه يُظهِرُ للأدمنِ سبباً لم يُكتَب.
          'plan_validation_failed', 'plan_validation_error',
          'plan_validation_at',
        ]);
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      // العقود إدارة طلبات: المالك + مدير الطلبات فقط (كان isAdmin يفتحها للمسوّق
      // والمحاسب رغم أن شاشة العقود محصورة بـ super_admin/orders_manager).
      allow update: if isOrdersManager() ||
        (isLoggedIn() && request.auth.uid == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'is_paid', 'paid_confirmed', 'planVisits', 'planPrice',
            'amount', 'visits_generated', 'activatedAt', 'paymentMethod']));
      allow delete: if isSuperAdmin();
    }

    // ─── Maintenance Requests (ARCHIVE — مغلقة للكتابة) ───────────────────
    // مسار «طلب عرض السعر» حُذف بالكامل بقرار المالك: المكيفات صارت طلباً مباشراً
    // مسعّراً، وصيانة الأجهزة المنزلية أُلغيت (لم يُنشأ لها طلب واحد قط). لم تبقَ في
    // التطبيق شاشةٌ تُنشئ مستنداً هنا.
    //
    // لذلك: **لا إنشاء ولا تعديل من العميل.** إبقاء `allow create` مفتوحاً بعد حذف
    // الواجهة يترك باباً خلفياً لكتابة مستندات لا تعرضها أي شاشة إدارية — تُنشأ ولا
    // يراها أحد. القاعدة تتبع الواقع: المجموعة أرشيف للقراءة.
    //
    // القراءة تبقى للإدارة وحدها: التحليلات (إيرادات تاريخية) والبحث تقرأ منها.
    // الحذف يبقى لـ super_admin لتنظيف الأرشيف عند الحاجة.
    match /maintenance_requests/{requestId} {
      allow create, update: if false;
      allow read: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Marketing & Content ──────────────────────────────────────────────
    match /subscription_packages/{packageId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /event_worker_packages/{packageId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_banners/{bannerId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_codes/{codeId} {
      // ⚠️ **لا تُنشَر هذه القاعدةُ قبلَ فرضِ الحدِّ الأدنى للإصدار** (نفسُ
      // حجزِ STAGE-C أعلاه، ولنفسِ السبب): النسخةُ المنشورةُ من التطبيق
      // تَستعلمُ `promo_codes` **بالكود** عند الدفع وبـ`status` في شاشةِ
      // العروض، وكلاهما لا يُثبِتُ شرطَ الأمانِ أدناه — فنشرُها مبكّراً
      // يَرفضُ **كلَّ** كوبونٍ لكلِّ عميلةٍ على النسخِ القديمة.
      //
      // ═══ لماذا ضُيِّقت ═══
      //
      // كانت `allow read: if isLoggedIn()`: أيُّ عميلةٍ مسجَّلةٍ تَقرأُ من
      // الـSDK **كلَّ كودِ خصمٍ في المستودع** — ومنها ما وسَمَته الإدارةُ
      // `show_in_offers: false` بعينِه. وتعليقُ `PromoCoupon` يَقولُ غرضَ
      // ذلك الحقلِ نصّاً: «الغيابُ = لا، كي لا يُكشَفَ كودُ قناةٍ خاصّة
      // (شريك/مؤثّر) لعمومِ العملاء بمجرّد ترقيةِ التطبيق» — قرارٌ مُنفَّذٌ
      // في الواجهةِ وحدَها، والبياناتُ مكشوفةٌ خلفَها. وسِرّيّةُ الكودِ هي
      // كلُّ ما يَحرسُه: من قرأه أنفقَه، والخادمُ يُجيزُه إن لم يكن موجَّهاً
      // ولا محصوراً بمنطقة.
      //
      // وقواعدُ Firestore تُجيزُ استعلامَ **قائمةٍ** متى أثبتَ مُرشِّحُه شرطَ
      // الأمان، فشاشةُ العروضِ صارت استعلامَين — المُعلَنُ، والموجَّهُ إلى
      // هذه العميلة — وكلٌّ يُثبِتُ أحدَ الفرعَين. والتحقّقُ بالكودِ انتقلَ
      // إلى `validateCouponCode` (onCall + `coupons.couponProblem`)، فلا
      // حاجةَ للعميلِ إلى قراءةِ المجموعةِ بالكودِ إطلاقاً.
      allow get, list: if isAdmin() ||
        (isLoggedIn() && (resource.data.show_in_offers == true ||
          resource.data.target_user_id == request.auth.uid));
      // SECURITY: عدّ الاستخدام صار خادمياً حصراً (countCouponUseOnOrderCreate عند تأكيد
      // الدفع، عبر Admin SDK المتجاوز للقواعد) — ولا كود عميل في التطبيق يزيد `uses`.
      // سماح «+1 لأي مستخدم» القديم كان باباً لإحراق أي كوبون حتى maxUses بلا شراء.
      allow update, create, delete: if isMarketingAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }

    // ─── Payroll (accountant + super admin only) ──────────────────────────
    match /payroll_records/{recordId} {
      allow read, write: if isAccountantAdmin();
    }

    // ─── System Settings ──────────────────────────────────────────────────
    // SECURITY: system_configs is read by clients (support contacts, payment options,
    // hourly settings) and drivers (capacity, feature flags) — write is admin-only.
    match /system_configs/{configId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Public content (privacy policy, …) ───────────────────────────────
    // القراءة عامة عمداً: صفحة zyiarah.com/privacy تقرأها **بلا تسجيل دخول**.
    // الكتابة للإدارة فقط — تُنشَر من لوحة التحكم عند حفظ سياسة الخصوصية.
    match /public_content/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── شروط وضوابط الخدمة (بنود مصنَّفة قابلة للتفعيل) ─────────────────────
    // تُعرض في شاشة الشروط التي تُفتح من التسجيل **قبل** الدخول، فالقراءة عامّة
    // كـ public_content. الكتابة للسوبر وحده — تعديل الشروط قرار إداري أعلى.
    // يحرسه functions/test/rules.policies.test.js.
    match /service_policies/{policyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // SECURITY: order/maintenance counters — read-only for users; write locked to increment-only.
    // Admins may also read aggregate docs (e.g. analytics_summary) written server-side.
    match /metadata/{docId} {
      allow get: if isLoggedIn() &&
        (docId in ['order_counter', 'maintenance_counter'] || isAdmin());
      allow create: if isLoggedIn() && docId in ['order_counter', 'maintenance_counter'];
      allow update: if isLoggedIn() && docId in ['order_counter', 'maintenance_counter'] && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_id']) &&
         request.resource.data.last_id == resource.data.last_id + 1)
      );
    }

    match /admins/{adminId} {
      allow read: if isLoggedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSuperAdmin();
    }
    match /services/{serviceId} {
      allow read: if isLoggedIn();
      // الأسعار قرار تشغيلي: المالك + مدير الطلبات فقط (يستثني المسوّق والمحاسب).
      allow write: if isOrdersManager();
    }

    // ─── Store ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /store_orders/{orderId} {
      // SECURITY: client_id must match caller on create, و is_paid=false (كالـ /orders) —
      // وإلا أنشأ عميل عبر SDK طلب متجر مدفوعاً فيُشحَن مجاناً.
      // ⚠️ **وكانت القائمةُ هنا اسمَين، والخادمُ يَكتبُ على طلبِ المتجرِ
      //    أعلامَ المراجعةِ نفسَها (2026-10-05).** `_verifyStoreOrderPrice`
      //    هو تحقّقُ السعرِ الوحيدُ لهذه المجموعةِ — فالسلّةُ تُعادُ
      //    تسعيرُها من `products` خادميّاً، وسياستُه Tier A: وسمٌ وتنبيهٌ لا
      //    رفض. فمُخرَجُه كلُّه أعلامٌ على المستند، وهي ما كان مكشوفاً:
      //
      //      • `price_mismatch: true` + `ops_alerted_mismatch: false` عند
      //        الإنشاءِ يُدخِلُ المستندَ في نافذةِ المكنسةِ (الكتلةُ ٥:
      //        مساواتانِ بهذين الحقلَين بعينِهما)، فتُنبّهُ الإدارةَ عن طلبٍ
      //        «دُفع بمبلغ أدنى من المتوقع» **بلا دفعٍ أصلاً**. والنافذةُ
      //        تُصرَّفُ نفسَها (`alertBatch` يَكتبُ العلمَ بعد الإرسال) فليس
      //        سدّاً دائماً للنافذة — بل **حقنُ تنبيهاتٍ** في القناةِ التي
      //        تَحملُ فشلَ الاستردادِ والتلاعبَ بالسعرِ والطلبَ المدفوعَ
      //        العالق: ضجيجٌ يُغرِقُ الحقيقيَّ، مُولَّدٌ بالطلبِ بلا كلفة.
      //      • `price_reviewed_at` وحدَه يَجعلُ `needsCard` صحيحةً و
      //        `actionable` كاذبةً، فتَرسمُ `admin_store_orders_screen`
      //        بطاقةً **خضراءَ** بأيقونةِ ✓ ونصِّ «سعر هذا الطلب اعتمدته
      //        مراجعة سابقة»، ومع `price_reviewed_by` تُذيّلُها «اعتُمد
      //        بواسطة …» — شهادةٌ لم يُوقّعها أحدٌ على الشاشةِ الوحيدةِ التي
      //        تَعرضُ طلباتِ المتجر. (وسمُ الخادمِ يَغلبُها في العرضِ متى
      //        وُسِمَ فعلاً، فالأثرُ ادّعاءٌ لا حَجبُ نقصٍ حقيقيّ — يُقالُ
      //        كما هو.)
      //
      //    و`moyasar_payment_id` كان محجوباً هنا وحدَه بظنٍّ أنّ العميلَ
      //    يَكتبُه شرعاً على `orders` — **وهو خادميٌّ خالصٌ** (صفرُ كاتبٍ في
      //    `lib/` واللوحة)، فدخلَ القائمةَ المشتركةَ وزالَ الاستثناء. وأثرُ
      //    غيابِه عن `orders` مشروحٌ عند اسمِه في `serverTrustFlags()`.
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid &&
        request.resource.data.get('is_paid', false) == false &&
        !request.resource.data.keys().hasAny(serverTrustFlags());
      // المحاسب يقرأ طلبات المتجر أيضاً: سجل الفواتير الإلكترونية يجمع فواتير
      // الخدمات والمتجر معاً (يحرسه rules.roles.test.js). الكتابة كما كانت.
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.client_id || isOrdersManager() ||
         isAccountantAdmin());
      // Client may finalise payment on their OWN order (mirrors the /orders trust model):
      // restricted to payment-completion fields and status -> processing only, so a paid
      // store order is no longer stuck after checkout. Full control stays with the manager.
      allow update: if isOrdersManager() ||
        // فرع الفاتورة وحده: بعد تأكيد الدفع خادمياً يكتب العميل رابط فاتورة
        // ZATCA وحالتها — الفرع العام أدناه يشترط is_paid==false فكان يحجبها.
        (isLoggedIn() && request.auth.uid == resource.data.client_id &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['invoice_pdf_url', 'invoice_pdf_status'])) ||
        (isLoggedIn() && request.auth.uid == resource.data.client_id &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['payment_method', 'is_paid', 'payment_status', 'status',
            'paid_at', 'invoice_pdf_url', 'delivery_location']) &&
         // المتجر المباشر: بعد الدفع يكتب العميل under_review (كانت processing).
         request.resource.data.status == 'under_review' &&
         // العميل لا يؤكّد الدفع بنفسه — is_paid يقلبه الـ webhook خادمياً.
         request.resource.data.is_paid == false);
      allow delete: if isOrdersManager();
    }

    // ─── Geographic Zones ─────────────────────────────────────────────────
    match /regions/{regionId} {
      allow read: if isLoggedIn();
      // المناطق/التسعير الجغرافي قرار تشغيلي: المالك + مدير الطلبات فقط.
      allow write: if isOrdersManager();
    }
    match /service_zones/{zoneId} {
      allow read: if isLoggedIn();
      allow write: if isOrdersManager();
    }

    // ─── Logs & Triggers ──────────────────────────────────────────────────

    // SECURITY: audit log entries must carry the caller's own uid
    match /audit_logs/{logId} {
      // سجلّ تدقيق إداري — الكتابة للأدمن فقط (كان أي مستخدم يكتب إدخالات باسمه = تلويث).
      allow create: if isAdmin() &&
        request.resource.data.get('admin_uid', request.auth.uid) == request.auth.uid;
      // قراءة سجلّ التدقيق للمدير العام وحده — شاشة «سجل العمليات الإدارية» محصورة به
      // أصلاً في الواجهة، وكان isAccountantAdmin يفتح تتبّع أفعال الإدارة لغير المخوَّل.
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // SECURITY: notification_triggers acts as a write-only queue for clients/drivers.
    // They append triggers, which are securely processed by server-side Cloud Functions.
    //
    // ⚠️ `createdBy` **يجب أن يكون معرّف المُنشئ نفسه.** كان `allow create: if
    // isLoggedIn()` بلا أيّ قيد على الحقول، فأيّ مستخدم مسجَّل يكتب
    // `createdBy: "server"` — وكانت الدالّة تَحسبه موثوقاً من هذا الحقل وحده
    // فيتخطّى حارسَ مكافحة الترحيل كلَّه: إشعار Push وسجلّ داخل التطبيق بعنوان
    // ونصّ من اختياره إلى **أيّ ضحيّة**، أو بثّ إداريّ مزيَّف، أو بريد من نطاق
    // المنشأة إلى أيّ عنوان (`recipientEmail` يأتي من المستند).
    //
    // الإصلاح الحامل للوزن خادميّ ولا ينتظر نشر القواعد: الدفع الخادميّ انتقل
    // إلى `notification_queue` — **بلا قاعدة مطابقة هنا**، فالعميل ممنوع منها
    // بالافتراض المُغلَق وAdmin SDK يتخطّى القواعد، والثقة تُحسَب من اسم
    // المجموعة لا من حقل. وهذا القيد دفاعٌ في العمق: يمنع انتحال هويّة موظّف
    // (الدالّة تقرأ `users/{createdBy}.role`) ويمنع عودة الثقة بالحقل.
    //
    // الكتبةُ الأربعة كلُّهم يكتبون معرّفهم: zyiarah_messaging_service (موضعان)،
    // admin_compliance_screen، وContracts.tsx (أُضيف — كان غائباً فيُرفَض
    // إشعارُ اعتماد العقد بصمت).
    match /notification_triggers/{triggerId} {
      allow create: if isLoggedIn() &&
        request.resource.data.get('createdBy', '') == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    match /notifications_log/{logId} {
      // 1) الإعلان المنبثق (type=='popup') يقرؤه كل مستخدم مسجّل — popup_service يستعلم
      //    where(type=='popup') فيثبت الشرط على مستوى الاستعلام (فهرس type+sent_at قائم).
      //    كانت القراءة محصورة بالمحاسب/المدير فلا يظهر المنبثق لأي عميل إطلاقاً.
      // 2) طابور الجدولة (status=='scheduled') يعيش هنا أيضاً: كل دور يستطيع الإنشاء
      //    (write: isAdmin) يجب أن يقرأ/يلغي طابوره — كان orders_manager/marketing_admin
      //    يجدولان ثم تختفي قائمتهما بـ permission-denied.
      allow read: if isAdmin() ||
        (isLoggedIn() && resource.data.type == 'popup');
      allow write: if isAdmin();
    }
    // سجلّ تنبيهات الإدارة (ADMIN_BROADCAST) — تستمع إليه لوحة الويب. خادمي الكتابة.
    match /admin_notifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isMarketingAdmin();
    }
    match /config/{configId} {
      allow read, write: if isSuperAdmin();
    }
    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }
    match /scheduled_notifications/{notifId} {
      allow read, write: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isLoggedIn() &&
        ((request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'is_read'])) ||
         isAdmin());
      allow create, delete: if isAdmin();
    }

    // ─── Referrals — تُدار خادمياً (applyReferralCode CF + onOrderRewards).
    // العميل يقرأ إحالته فقط؛ الكتابة من العميل ممنوعة كي لا يزوّر المُحيل
    // (referrer_id) فيمنح مكافأة إحالة لأي شخص.
    match /referrals/{refId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == refId ||
         request.auth.uid == resource.data.referee_id ||
         request.auth.uid == resource.data.referrer_id ||
         isAdmin());
      allow write: if false; // خادمي فقط (Admin SDK يتجاوز القواعد)
    }
  }
}
