rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // Single get() (rules cache same-path reads) — the EFFECTIVE role.
    // SECURITY: staff docs store their real sub-role in `staff_role` while `role`
    // stays the generic 'admin'. Preferring staff_role makes isOrdersManager/
    // isMarketingAdmin/isAccountantAdmin/isSuperAdmin actually separate staff
    // (previously every staff member = 'admin' = full super_admin). Bootstrapped
    // super admins have no staff_role, so they fall back to `role` and stay super.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function getUserRole() {
      return getUserData().get('staff_role', getUserData().get('role', 'client'));
    }

    // Any admin role
    function isAdmin() {
      return isLoggedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        getUserRole() in ['admin', 'super_admin', 'orders_manager',
                          'accountant_admin', 'marketing_admin']
      );
    }

    // Orders + drivers management
    function isOrdersManager() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'orders_manager'];
    }

    // Financial read access
    function isAccountantAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'accountant_admin'];
    }

    // Marketing content management
    function isMarketingAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin', 'marketing_admin'];
    }

    // Destructive operations: delete users, change system config
    function isSuperAdmin() {
      return isLoggedIn() &&
        getUserRole() in ['admin', 'super_admin'];
    }

    // ─── User Profiles ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // SECURITY: privileged accounts are provisioned by an admin (createAccountViaAdmin
      // writes the users doc under the admin's auth); a regular user may only create their
      // own profile and can never self-assign a privileged role.
      allow create: if
        // Super admin: provision any account (staff / drivers)
        isSuperAdmin() ||
        // Orders manager: may provision driver accounts only (not other admins),
        // and never a privileged staff_role (blocks escalation via sub-provisioning)
        (isOrdersManager() &&
          request.resource.data.get('role', 'client') == 'driver' &&
          request.resource.data.get('staff_role', 'client') == 'client') ||
        // Self-signup: own doc, non-privileged role AND non-privileged staff_role only.
        // SECURITY: getUserRole() trusts staff_role BEFORE role, so it must be guarded
        // here too — otherwise a client self-signs with staff_role='super_admin'.
        (isOwner(userId) &&
          !(request.resource.data.get('role', 'client') in
            ['admin', 'super_admin', 'orders_manager',
             'accountant_admin', 'marketing_admin', 'driver']) &&
          request.resource.data.get('staff_role', 'client') == 'client');

      // SECURITY: only super_admin may set role/is_blocked (prevents a sub-admin from
      // self-escalating to super_admin or blocking users); the `wallet` field on the
      // user doc is never client-writable (the real balance lives in /wallets, server-only).
      allow update: if
        // Super admin: create staff/drivers (role), ban users (is_blocked) — but not wallet
        (isSuperAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet'])) ||
        // Other admins: edit user profile fields, but never role / staff_role / wallet /
        // is_blocked / visits_remaining. SECURITY: staff_role IS the effective role
        // (getUserRole trusts it first), so only a super_admin may set it — a sub-admin
        // must not self-escalate. visits_remaining is a prepaid subscription-credit
        // counter (server-managed) and must not be granted outside payment.
        // SECURITY: `status` هو علم الحظر الثاني (user_provider يطرد status=='banned') —
        // الحظر/رفعه قرار للمدير العام وحده، أسوةً بـ is_blocked.
        (isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'staff_role', 'wallet', 'is_blocked', 'status',
                     'visits_remaining'])) ||
        // Owner: own non-sensitive fields only. visits_remaining / subscription credits
        // are server-only (they represent paid subscription visits — never client-writable).
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            // SECURITY: `status` محظور على المالك أيضاً — وإلا رفع المحظور حظره بنفسه
            // بكتابة status:'active' (user_provider يفحص status=='banned').
            .hasAny(['role', 'staff_role', 'wallet', 'rating_avg', 'rating_count',
                     'total_orders', 'is_blocked', 'status', 'visits_remaining',
                     'subscription_expiry', 'subscription_total_visits',
                     // خادمية فقط (activateContractOnPaid) — منعُ تزييف بطاقة اشتراك.
                     'has_active_subscription', 'subscription_type']));

      allow delete: if isSuperAdmin();
    }

    // ─── Accountants ──────────────────────────────────────────────────────
    match /accountants/{accountantId} {
      allow read: if isOwner(accountantId) || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isOwner(accountantId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'is_active', 'email']));
    }

    // ─── Account Deletion Requests ────────────────────────────────────────
    // SECURITY: the doc ID IS the target uid, and onAccountDeletionRequested deletes
    // that auth user + users doc when status=='deleted'. A caller may therefore ONLY
    // request deletion of their OWN account — otherwise any user could wipe any other
    // account (including admins) by writing account_deletions/{victimUid}.
    match /account_deletions/{deletionId} {
      // super admin يحذف مستخدماً آخر عبر كتابة الطلب هنا → processAccountDeletion يحذف
      // حساب Auth + مستند users + رموز FCM. كان حذف الأدمن يمسح مستند users فقط ويترك
      // حساب Auth حيّاً قابلاً للدخول. (العميل يحذف حسابه هو فقط — isOwner.)
      allow create: if isOwner(deletionId) || isSuperAdmin();
      allow read, update, delete: if isSuperAdmin();
    }

    // ─── Support Tickets ──────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if isLoggedIn() && (
          request.auth.uid ==
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
          || isAdmin()
        );
      }
    }

    // Legacy tickets collection
    match /tickets/{ticketId} {
      allow read, update: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.driver_id ||
        isAdmin()
      );

      // SECURITY: client_id must match caller; initial status limited to safe entry states.
      // ⚠️ المرحلة C من ترحيل الدفع: العميل لا ينشئ طلباً مدفوعاً (is_paid=true) ولا يكتب
      // أي حقل ثقة خادمي عند الإنشاء — is_paid يقلبه الخادم فقط (verifyMoyasarPayment /
      // payWithWallet / webhooks). يُغلق سكّ المحفظة. **لا تُنشَر إلا بعد انتشار التطبيق
      // الجديد (ينشئ is_paid=false) وفرض الحد الأدنى للإصدار** — وإلا تنكسر مدفوعات النسخ
      // القديمة. (STAGE-C — DO NOT DEPLOY UNTIL THE NEW APP IS THE MINIMUM VERSION.)
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid &&
        request.resource.data.get('status', 'pending') in
          ['pending', 'awaiting_payment'] &&
        request.resource.data.get('is_paid', false) == false &&
        !request.resource.data.keys().hasAny([
          'needs_refund', 'refund_credited', 'rewards_handled_by',
          'qatrat_granted', 'visit_counted', 'coupon_counted', 'paid_confirmed',
          // SECURITY: الإسناد قرار خادمي/إداري حصراً — عميلٌ يكتب driver_id عند الإنشاء
          // كان يزرع سائقاً من اختياره في مهامّه ويتجاوز محرّك التوزيع (لا مسار شرعي
          // في التطبيق يكتبه عند الإنشاء).
          'driver_id',
        ]);

      // Orders manager: full update (approve, assign driver -> scheduled, override status)
      allow update: if isOrdersManager();

      // Driver (Direct Dispatch): may ONLY advance an assigned task forward + sync location.
      // No accept/reject, no self-reassignment, no identity/amount tampering, and — since
      // cash-on-delivery was removed at the root — NO payment fields at all: a driver can
      // no longer mark an order paid. Payment is always upfront and confirmed server-side
      // (webhook / verifyMoyasarPayment / payWithWallet).
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.driver_id &&
        resource.data.status in ['scheduled', 'on_the_way', 'in_progress', 'accepted'] &&
        // إمّا تبقى الحالة كما هي (كتابة موقع/قرب لا تغيّرها — كان طلب 'accepted'
        // يُرفَض صامتاً فتتجمّد خريطة العميل)، أو تتقدّم للأمام فقط. صياغة «البقاء
        // أو التقدّم» أدقّ من قائمةٍ ثابتة: تغطّي كتابة الموقع في أي حالة نشطة،
        // وتمنع الرجوع للخلف (in_progress → accepted) الذي تسمح به قائمةٌ صرفة.
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status in ['on_the_way', 'in_progress', 'completed']) &&
        // 'rewards_handled_by' مسموح: تكتبه عند الإكمال ليعالج الخادم الجوائز (onOrderRewards)
        // 'completed_distance_m' مسموح: يكتبه driver_dashboard عند الإكمال متى توفّر GPS.
        //   كان غائباً عن هذه القائمة، و hasOnly ترفض **المعاملة كاملة** لأي مفتاح خارجها —
        //   أي أن إكمال الطلب كان يفشل لدى كل سائق يعمل GPS جهازه، بينما ينجح لمن لا يعمل.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'on_the_way_at', 'arrived_at', 'start_time', 'end_time',
          'driver_location', 'last_location_update', 'updated_at',
          'completed_distance_m',
          'rewards_handled_by', 'proximity_notified'
        ]) &&
        // (#43) مرساة زمنية موثوقة: إن كُتب start_time/end_time فيجب أن يساوي request.time.
        // كتابة FieldValue.serverTimestamp() تُحلّ إلى request.time فتمرّ؛ أي قيمة حرفية
        // مزوَّرة تُرفَض — فلا يزوّر السائق مدّة الخدمة (يعتمد عليها لون التخطّي وشارات الإدارة).
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['start_time']) ||
          request.resource.data.start_time == request.time) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['end_time']) ||
          request.resource.data.end_time == request.time);

      // Client: cancel own pending order, update invoice URL, or submit rating
      allow update: if isLoggedIn() &&
        request.auth.uid == resource.data.client_id &&
        (
          // 1. Cancellation flow — only before the task is dispatched to a driver
          (resource.data.status in ['pending', 'awaiting_payment'] &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelled_at', 'cancelled_by', 'needs_refund', 'rewards_handled_by']) &&
           request.resource.data.status == 'cancelled')
          ||
          // 2. Invoice PDF URL update flow — يشمل invoice_pdf_status: مولّد
          //    الفاتورة يكتب حالة إعادة المحاولة، وكانت خارج القائمة فتُرفض
          //    المعاملة كاملة ويتعطل مسار إعادة توليد الفاتورة.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['invoice_pdf_url', 'invoice_pdf_status']))
          ||
          // 3. Rating flow (only allowed once rating is not already set)
          (resource.data.get('rating', null) == null &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rating', 'rating_comment', 'rating_reason', 'rating_evidence_url', 'rated_at']))
        );

      allow delete: if isSuperAdmin();
    }

    // ─── Drivers ──────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == driverId || isAdmin());
      allow write: if isOrdersManager();
      // Driver can update own availability/location — not financial or identity fields
      allow update: if isLoggedIn() &&
        request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['name', 'phone', 'monthly_salary', 'wallet',
                   'rating_avg', 'rating_count', 'rides', 'email',
                   'id_number', 'id_expiry', 'nationality']);
    }

    // ─── FCM Tokens ───────────────────────────────────────────────────────
    // SECURITY: the `role` field on a token drives ADMIN_BROADCAST fan-out. A user must
    // not tag their own device with a privileged role to eavesdrop on admin pushes, so a
    // self-write must carry the caller's real users/{uid}.role (exactly what the app writes).
    // Delete is unrestricted for owner/admin so sign-out cleanup still works.
    match /fcm_tokens/{tokenId} {
      allow read, delete: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
      allow create, update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == tokenId &&
          request.resource.data.get('role', 'client') == getUserData().get('role', 'client') &&
          // SECURITY: لا يجوز وسم الجهاز بدور فرعي إداري لا يملكه المستخدم — توجيه
          // ADMIN_BROADCAST يفلتر على staff_role، فتركُه دون قيد كان يتيح التنصّت.
          request.resource.data.get('staff_role', null) == getUserData().get('staff_role', null)));
    }
    match /fcm_token/{tokenId} {
      allow read, delete: if isLoggedIn() &&
        (request.auth.uid == tokenId || isAdmin());
      allow create, update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == tokenId &&
          request.resource.data.get('role', 'client') == getUserData().get('role', 'client') &&
          // SECURITY: لا يجوز وسم الجهاز بدور فرعي إداري لا يملكه المستخدم — توجيه
          // ADMIN_BROADCAST يفلتر على staff_role، فتركُه دون قيد كان يتيح التنصّت.
          request.resource.data.get('staff_role', null) == getUserData().get('staff_role', null)));
    }

    // ─── Wallets & Transactions ───────────────────────────────────────────
    // SECURITY: الرصيد والمعاملات تُكتب حصرياً من Cloud Functions عبر Admin SDK
    // (payWithWallet / redeemQatratPoints / onOrderRewards) — لا كتابة من العميل.
    match /wallets/{walletId} {
      allow read: if isLoggedIn() && (request.auth.uid == walletId || isAdmin());
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isLoggedIn() && (request.auth.uid == walletId || isAdmin());
        allow write: if false;
      }
    }

    // ─── Contracts (subscriptions) ────────────────────────────────────────
    // SECURITY: userId must match caller on create, and the owner can NEVER self-set a
    // paid/active status or plan/visits fields. generateSubscriptionVisits mints paid
    // (is_paid=true) visit-orders once a contract is 'active'; without this guard any
    // client could activate their own contract and get free subscription visits.
    // Activation/payment must be server- or admin-gated (mirrors the Stage-C order model).
    match /contracts/{contractId} {
      // SECURITY (CRITICAL): العقد ينشئه العميل موقَّعاً بحقول planPrice/planVisits من
      // الواجهة، والخادم يحاسبه على planPrice كما هو (verifyMoyasarPayment /
      // payContractWithWallet تقرآن planPrice من المستند). لا يمكن للقواعد مطابقة السعر
      // مع subscription_packages (لا معرّف باقة على العقد)، فنحصر الإنشاء في الشكل
      // الشرعي الوحيد (contract_signing_screen): status=='pending'، غير مدفوع، أرقام
      // موجبة، وبلا أي حقل ثقة خادمي (التفعيل/التوليد/الأرصدة يكتبها الخادم فقط).
      // ⚠️ الحسم النهائي لسعر الباقة يبقى تحققاً خادمياً (انظر تقرير التدقيق).
      allow create: if isLoggedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('is_paid', false) == false &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('planPrice', 0) is number &&
        request.resource.data.get('planPrice', 0) > 0 &&
        request.resource.data.get('planVisits', 0) is number &&
        request.resource.data.get('planVisits', 0) > 0 &&
        !request.resource.data.keys().hasAny([
          'paid_confirmed', 'visits_generated', 'visits_generated_at',
          'activatedAt', 'activated_at', 'adminApprovedAt', 'paid_at',
          'visits_remaining', 'visits_total', 'expiry', 'amount',
        ]);
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      // العقود إدارة طلبات: المالك + مدير الطلبات فقط (كان isAdmin يفتحها للمسوّق
      // والمحاسب رغم أن شاشة العقود محصورة بـ super_admin/orders_manager).
      allow update: if isOrdersManager() ||
        (isLoggedIn() && request.auth.uid == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'is_paid', 'paid_confirmed', 'planVisits', 'planPrice',
            'amount', 'visits_generated', 'activatedAt', 'paymentMethod']));
      allow delete: if isSuperAdmin();
    }

    // ─── Maintenance Requests (ARCHIVE — مغلقة للكتابة) ───────────────────
    // مسار «طلب عرض السعر» حُذف بالكامل بقرار المالك: المكيفات صارت طلباً مباشراً
    // مسعّراً، وصيانة الأجهزة المنزلية أُلغيت (لم يُنشأ لها طلب واحد قط). لم تبقَ في
    // التطبيق شاشةٌ تُنشئ مستنداً هنا.
    //
    // لذلك: **لا إنشاء ولا تعديل من العميل.** إبقاء `allow create` مفتوحاً بعد حذف
    // الواجهة يترك باباً خلفياً لكتابة مستندات لا تعرضها أي شاشة إدارية — تُنشأ ولا
    // يراها أحد. القاعدة تتبع الواقع: المجموعة أرشيف للقراءة.
    //
    // القراءة تبقى للإدارة وحدها: التحليلات (إيرادات تاريخية) والبحث تقرأ منها.
    // الحذف يبقى لـ super_admin لتنظيف الأرشيف عند الحاجة.
    match /maintenance_requests/{requestId} {
      allow create, update: if false;
      allow read: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Marketing & Content ──────────────────────────────────────────────
    match /subscription_packages/{packageId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_banners/{bannerId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /promo_codes/{codeId} {
      allow read: if isLoggedIn();
      // SECURITY: عدّ الاستخدام صار خادمياً حصراً (countCouponUseOnOrderCreate عند تأكيد
      // الدفع، عبر Admin SDK المتجاوز للقواعد) — ولا كود عميل في التطبيق يزيد `uses`.
      // سماح «+1 لأي مستخدم» القديم كان باباً لإحراق أي كوبون حتى maxUses بلا شراء.
      allow update, create, delete: if isMarketingAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }

    // ─── Payroll (accountant + super admin only) ──────────────────────────
    match /payroll_records/{recordId} {
      allow read, write: if isAccountantAdmin();
    }

    // ─── System Settings ──────────────────────────────────────────────────
    // SECURITY: system_configs is read by clients (support contacts, payment options,
    // hourly settings) and drivers (capacity, feature flags) — write is admin-only.
    match /system_configs/{configId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Public content (privacy policy, …) ───────────────────────────────
    // القراءة عامة عمداً: صفحة zyiarah.com/privacy تقرأها **بلا تسجيل دخول**.
    // الكتابة للإدارة فقط — تُنشَر من لوحة التحكم عند حفظ سياسة الخصوصية.
    match /public_content/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // SECURITY: order/maintenance counters — read-only for users; write locked to increment-only.
    // Admins may also read aggregate docs (e.g. analytics_summary) written server-side.
    match /metadata/{docId} {
      allow get: if isLoggedIn() &&
        (docId in ['order_counter', 'maintenance_counter'] || isAdmin());
      allow create: if isLoggedIn() && docId in ['order_counter', 'maintenance_counter'];
      allow update: if isLoggedIn() && docId in ['order_counter', 'maintenance_counter'] && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_id']) &&
         request.resource.data.last_id == resource.data.last_id + 1)
      );
    }

    match /admins/{adminId} {
      allow read: if isLoggedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSuperAdmin();
    }
    match /services/{serviceId} {
      allow read: if isLoggedIn();
      // الأسعار قرار تشغيلي: المالك + مدير الطلبات فقط (يستثني المسوّق والمحاسب).
      allow write: if isOrdersManager();
    }

    // ─── Store ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isLoggedIn();
      allow write: if isMarketingAdmin();
    }
    match /store_orders/{orderId} {
      // SECURITY: client_id must match caller on create, و is_paid=false (كالـ /orders) —
      // وإلا أنشأ عميل عبر SDK طلب متجر مدفوعاً فيُشحَن مجاناً.
      allow create: if isLoggedIn() &&
        request.resource.data.client_id == request.auth.uid &&
        request.resource.data.get('is_paid', false) == false &&
        !request.resource.data.keys().hasAny(['paid_confirmed', 'moyasar_payment_id']);
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.client_id || isOrdersManager());
      // Client may finalise payment on their OWN order (mirrors the /orders trust model):
      // restricted to payment-completion fields and status -> processing only, so a paid
      // store order is no longer stuck after checkout. Full control stays with the manager.
      allow update: if isOrdersManager() ||
        // فرع الفاتورة وحده: بعد تأكيد الدفع خادمياً يكتب العميل رابط فاتورة
        // ZATCA وحالتها — الفرع العام أدناه يشترط is_paid==false فكان يحجبها.
        (isLoggedIn() && request.auth.uid == resource.data.client_id &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['invoice_pdf_url', 'invoice_pdf_status'])) ||
        (isLoggedIn() && request.auth.uid == resource.data.client_id &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['payment_method', 'is_paid', 'payment_status', 'status',
            'paid_at', 'invoice_pdf_url', 'delivery_location']) &&
         // المتجر المباشر: بعد الدفع يكتب العميل under_review (كانت processing).
         request.resource.data.status == 'under_review' &&
         // العميل لا يؤكّد الدفع بنفسه — is_paid يقلبه الـ webhook خادمياً.
         request.resource.data.is_paid == false);
      allow delete: if isOrdersManager();
    }

    // ─── Geographic Zones ─────────────────────────────────────────────────
    match /regions/{regionId} {
      allow read: if isLoggedIn();
      // المناطق/التسعير الجغرافي قرار تشغيلي: المالك + مدير الطلبات فقط.
      allow write: if isOrdersManager();
    }
    match /service_zones/{zoneId} {
      allow read: if isLoggedIn();
      allow write: if isOrdersManager();
    }

    // ─── Logs & Triggers ──────────────────────────────────────────────────

    // SECURITY: audit log entries must carry the caller's own uid
    match /audit_logs/{logId} {
      // سجلّ تدقيق إداري — الكتابة للأدمن فقط (كان أي مستخدم يكتب إدخالات باسمه = تلويث).
      allow create: if isAdmin() &&
        request.resource.data.get('admin_uid', request.auth.uid) == request.auth.uid;
      // قراءة سجلّ التدقيق للمدير العام وحده — شاشة «سجل العمليات الإدارية» محصورة به
      // أصلاً في الواجهة، وكان isAccountantAdmin يفتح تتبّع أفعال الإدارة لغير المخوَّل.
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // SECURITY: notification_triggers acts as a write-only queue for clients/drivers.
    // They append triggers, which are securely processed by server-side Cloud Functions.
    match /notification_triggers/{triggerId} {
      allow create: if isLoggedIn();
      allow read, delete: if isAdmin();
    }

    match /notifications_log/{logId} {
      // 1) الإعلان المنبثق (type=='popup') يقرؤه كل مستخدم مسجّل — popup_service يستعلم
      //    where(type=='popup') فيثبت الشرط على مستوى الاستعلام (فهرس type+sent_at قائم).
      //    كانت القراءة محصورة بالمحاسب/المدير فلا يظهر المنبثق لأي عميل إطلاقاً.
      // 2) طابور الجدولة (status=='scheduled') يعيش هنا أيضاً: كل دور يستطيع الإنشاء
      //    (write: isAdmin) يجب أن يقرأ/يلغي طابوره — كان orders_manager/marketing_admin
      //    يجدولان ثم تختفي قائمتهما بـ permission-denied.
      allow read: if isAdmin() ||
        (isLoggedIn() && resource.data.type == 'popup');
      allow write: if isAdmin();
    }
    // سجلّ تنبيهات الإدارة (ADMIN_BROADCAST) — تستمع إليه لوحة الويب. خادمي الكتابة.
    match /admin_notifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isMarketingAdmin();
    }
    match /config/{configId} {
      allow read, write: if isSuperAdmin();
    }
    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }
    match /scheduled_notifications/{notifId} {
      allow read, write: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isLoggedIn() &&
        ((request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'is_read'])) ||
         isAdmin());
      allow create, delete: if isAdmin();
    }

    // ─── Referrals — تُدار خادمياً (applyReferralCode CF + onOrderRewards).
    // العميل يقرأ إحالته فقط؛ الكتابة من العميل ممنوعة كي لا يزوّر المُحيل
    // (referrer_id) فيمنح مكافأة إحالة لأي شخص.
    match /referrals/{refId} {
      allow read: if isLoggedIn() &&
        (request.auth.uid == refId ||
         request.auth.uid == resource.data.referee_id ||
         request.auth.uid == resource.data.referrer_id ||
         isAdmin());
      allow write: if false; // خادمي فقط (Admin SDK يتجاوز القواعد)
    }
  }
}
