# The path to the flutter_ios_podfile.rb
def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get has been run."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

platform :ios, '15.0'

# لا تُثبِّت $FirebaseSDKVersion هنا. اترك firebase_core يفرض نسخته المعلَنة.
#
# الدرس (2026-09-13، البناء ٢١٠): كان هنا تثبيتٌ على 12.13.0 وُضع حين كانت
# cloud_firestore 6.4.x تنادي selector الـPipeline القديم
# (initWithRef:firestore:) الذي كسرته 12.14.0. ثم رُقّيت cloud_firestore إلى
# 6.9.0، فصارت تنادي الصيغة الجديدة (initWithRef:firestore:forceIndex:)
# المعرَّفة في 12.17.0 فأعلى — والتثبيت انقلب من علاجٍ إلى سببٍ للعطل:
#
#   No visible @interface for 'FIRCollectionSourceStageBridge'
#   declares the selector 'initWithRef:firestore:forceIndex:'
#
# والسبب أن podspecs تعطي الأولوية لهذا المتغيّر العام على ما يعلنه
# firebase_core (شرطُ `if defined?($FirebaseSDKVersion)` في كل podspec)،
# فبقي التثبيت يشدّ SDK إلى الخلف بينما شجرة Dart تتقدّم — بصمت، لأن
# التعارض لا يظهر إلا عند تصريف Objective-C في بناء iOS حقيقي.
#
# يحرس هذا test/ios_firebase_sdk_pin_test.dart: إن أُعيد التثبيت يوماً
# لضرورة، يجب ألّا يكون أدنى مما يعلنه firebase_core.

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

# Disable Flutter's Swift Package Manager integration to avoid
# cloud_firestore FLTPipelineParser.m compilation bug (6.4.x)
ENV['FLUTTER_USE_SWIFT_PACKAGE_MANAGER'] = 'false'

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :release,
}

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Force iOS 13 for all pods to match deployment target
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
