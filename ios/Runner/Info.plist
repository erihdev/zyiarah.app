<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- التطبيقُ عربيٌّ (main.dart يَفرضُ Locale('ar')) وكانت الحزمةُ تُعلِنُ
		     الإنجليزيّةَ وحدَها، فتَعرضُ صفحةُ المتجرِ «English» وتَأتي نوافذُ
		     أذونِ النظامِ بالإنجليزيّة (2026-10-22). -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>ar</string>
			<string>en</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>زيارة</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Zyiarah</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>app-1-275681992607-ios-46ef8f0f245398f7b127aa</string>
					<string>zyiarah</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIBackgroundModes</key>
		<!-- `fetch` حُذِف (2026-10-22): لا BGTaskScheduler ولا background_fetch ولا
		     workmanager في المستودعِ كلِّه، و`firebase_messaging` يَحتاجُ
		     `remote-notification` وحدَه. نمطٌ بلا ميزةٍ هو بندُ 2.5.4 نفسُه الذي
		     رُفضت به 1.2.50 (نمطُ `location`). يَشدُّه `permissions_guard_test`. -->
		<array>
			<string>remote-notification</string>
		</array>
		<key>FirebaseAppDelegateProxyEnabled</key>
		<false/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>نحتاج للوصول إلى موقعك لربطك بأقرب سائق متاح وتحديد موقع الخدمة بدقة في المناطق الجبلية.</string>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- نصُّ السببِ يُقرأُ في مراجعةِ أبل وفي نافذةِ الإذنِ معاً، فيَجبُ
	     أن يُسمّي ما يَحدثُ فعلاً. كان: «مسح الـ QR Code الخاص بالفواتير أو
	     تحديث صورة الملف الشخصي» — و**لا ماسحَ QR في المستودعِ إطلاقاً**
	     (`Barcode` الوحيدُ في `zyiarah_pdf_service` يُولِّدُ رمزاً لا
	     يَقرؤه)، **ولا مسارَ صورةٍ شخصيّةٍ للعميلة** (الرفعُ الوحيدُ
	     `uploadWorkerPhoto` إداريّ). والاستعمالاتُ الحقيقيّةُ أربعةٌ:
	     إثباتٌ مع التقييم (`rating_dialog`)، وصورُ العاملين والمنتجاتِ
	     والعروضِ من شاشاتِ الإدارة. وهو نظيرُ سببِ الميكروفونِ الذي كان
	     يُسمّي «تابي» بعد إزالتِها — سؤالُ مراجعةٍ لا أكثر. -->
		<key>NSCameraUsageDescription</key>
		<string>نستخدم الكاميرا لتصوير إثبات مع تقييم الخدمة، ولتصوير صور العاملين والمنتجات والعروض من حساب الإدارة.</string>
		<!-- كان: «حفظ صور الفواتير الضريبية أو تحديث ملفك الشخصي» — و**لا
	     شيءَ يَكتبُ إلى مكتبةِ الصور** (لا `image_gallery_saver` ولا
	     نظيرَه؛ الفاتورةُ تُشارَكُ PDFاً)، والمكتبةُ تُقرأُ في ثلاثةِ
	     مواضعَ إداريّةٍ وحدَها (`ImageSource.gallery`). -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>نحتاج الوصول إلى صورك لاختيار صور العاملين والمنتجات والعروض من حساب الإدارة.</string>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<!-- NSMicrophoneUsageDescription حُذِف (2026-10-05): لا استعمالَ
		     للميكروفونِ في المستودعِ كلِّه، وسببُه المُعلَنُ كان «تابي
		     يحتاج إلى الميكروفون للتحقق من هوية المستخدم» — وتابي أُزيلت
		     من العميلِ في 2026-09-30. ونصُّ سببٍ يُسمّي طرفاً ثالثاً ليس
		     في التطبيقِ هو ما يَقرؤه مُراجِعُ آبل. -->
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
