rules_version = '2';

// قواعد أمان Firebase Storage — لم تكن منشورة من المشروع (كانت قواعد الكونسول
// الافتراضية تحظر الرفع فيفشل رفع البنرات/المنتجات). تغطّي كل مسارات الرفع في
// التطبيق. القراءة عبر رابط التنزيل (token) تعمل دائماً؛ هذه القواعد تحكم الكتابة.
service firebase.storage {
  match /b/{bucket}/o {

    // البنرات الإعلانية — تُعرض للعملاء (قراءة عامة)، يكتبها مستخدم مُصادَق (الأدمن عبر الواجهة)
    match /banners/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // صور منتجات المتجر — تُعرض للعملاء
    match /products/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // صور العاملات
    match /worker_photos/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // إثبات إكمال الطلب (يرفعه السائق) — قراءة للمصادَقين فقط
    match /order_feedback/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }

    // فواتير PDF (يرفعها العميل بعد الدفع) — قراءة للمصادَقين فقط
    match /invoices/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }

    // كل ما عدا ذلك ممنوع
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
